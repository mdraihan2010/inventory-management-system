// Activity Diagram: Purchase process (draft, complete, pay supplier)
// Follows purchaseController.js, purchaseStatusController.js and supplierPaymentController.js
// Render: dot -Tpdf activity-purchase.dot -o activity-purchase.pdf
digraph PurchaseActivity {
  graph [rankdir=TB, fontname="Latin Modern Roman,10 Regular", fontsize=13, nodesep=0.35, ranksep=0.32,
         newrank=true, splines=ortho, pad=0.2, labelloc=t];
  node  [fontname="Latin Modern Roman,10 Regular", fontsize=11, shape=box, style="rounded,filled",
         fillcolor=white, width=2.3, height=0.42, margin="0.12,0.05"];
  edge  [fontname="Latin Modern Roman,10 Regular", fontsize=10, arrowsize=0.7];

  subgraph cluster_user {
    label=<<b>Manager / Administrator</b>>; style="rounded"; color=gray50; margin=14;
    start [shape=circle, style=filled, fillcolor=black, label="", width=0.22, height=0.22];
    open      [label="Open New purchase,\nselect supplier"];
    addItems  [label="Search products, enter quantity;\nunit price is filled from the\nproduct's purchase price"];
    received  [shape=diamond, style=filled, fillcolor=white, label="", width=0.38, height=0.38];
    cancel    [label="Cancel draft"];
    pressDone [label="Press Complete"];
    payNow    [shape=diamond, style=filled, fillcolor=white, label="", width=0.38, height=0.38];
    enterPay  [label="Pay supplier:\namount, method, reference"];
    end1 [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.14, height=0.14];
    end2 [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.14, height=0.14];
  }

  subgraph cluster_system {
    label=<<b>System (Express API + MongoDB)</b>>; style="rounded"; color=gray50; margin=14;
    validate  [label="Validate: supplier active,\nno product twice,\ndiscount within subtotal"];
    saveDraft [label="Save purchase as DRAFT\n(stock not changed yet)"];
    markCancel[label="Mark purchase CANCELLED"];
    subgraph cluster_tx1 {
      label=<<i>One MongoDB transaction</i>>; style="dashed,rounded"; color=gray40; margin=10;
      isDraft   [shape=diamond, style=filled, fillcolor=white, label="", width=0.38, height=0.38];
      increase  [label="For each item: increase stock,\nwrite PURCHASE stock movement"];
      completed [label="Mark purchase COMPLETED"];
      refuse    [label="Refuse: only a draft\ncan be completed", fillcolor="#fdecea"];
    }
    end3 [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.14, height=0.14];
    audit1    [label="Write audit log"];
    subgraph cluster_tx2 {
      label=<<i>One MongoDB transaction</i>>; style="dashed,rounded"; color=gray40; margin=10;
      checkAmt  [shape=diamond, style=filled, fillcolor=white, label="", width=0.38, height=0.38];
      savePay   [label="Add to paid amount;\nsave supplier payment"];
      reject    [label="Reject: more than\nwhat is still owed", fillcolor="#fdecea"];
    }
    audit2    [label="Write audit log;\nstatus Paid / Partly paid"];
  }

  start -> open -> addItems -> validate -> saveDraft -> received;
  received -> cancel    [xlabel="[order wrong or\nnot coming]"];
  cancel -> markCancel -> end1;
  received -> pressDone [xlabel="[goods received]"];
  pressDone -> isDraft;
  isDraft -> refuse   [xlabel="[already completed\nor cancelled]"];
  isDraft -> increase [xlabel="[draft]"];
  increase -> completed -> audit1 -> payNow;
  refuse -> end3;
  payNow -> end2     [xlabel="[pay later]"];
  payNow -> enterPay [xlabel="[pay now]"];
  enterPay -> checkAmt;
  checkAmt -> reject  [xlabel="[amount > total -\nreturned - paid]"];
  checkAmt -> savePay [xlabel="[ok]"];
  reject -> enterPay [constraint=false];
  savePay -> audit2;
  audit2 -> payNow [constraint=false, xlabel="[more still owed]"];
}
