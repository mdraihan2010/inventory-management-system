  legend [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#888888"><TR><TD ALIGN="LEFT"><B>How to read</B></TD></TR><TR><TD ALIGN="LEFT">PK = primary key (_id), FK = reference to another collection, UQ = unique</TD></TR><TR><TD ALIGN="LEFT">&#8627; rows in grey are stored inside the document (embedded items array)</TD></TR><TR><TD ALIGN="LEFT">Crow foot = many; bar = exactly one; bar + circle = zero or one</TD></TR><TR><TD ALIGN="LEFT">createdBy / cancelledBy point to users (who did it); lines left out for clarity</TD></TR><TR><TD ALIGN="LEFT">Every collection also has createdAt and updatedAt (Mongoose timestamps)</TD></TR></TABLE>>];
